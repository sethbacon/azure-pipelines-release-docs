node_modules/
build/
coverage/
*.tsbuildinfo
*.vsix

# Compiled task output. The .ts is the source of record and the packager
# compiles on the way in, so a local build must not leave .js staged.
# Mirrors azure-pipelines-terraform and -packer.
Tasks/**/*.js
.nyc_output/
.taskkey

# Release-pipeline outputs, produced at the repo root by .github/workflows/release.yml
# and attached to the GitHub Release. Ignored so a local reproduction of that
# pipeline cannot leave a generated artifact staged.
*.vsix.bundle
sbom-*.cdx.json

# Personal publisher override — never commit
configs/self.json

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local secrets
.env
.env.*
*.pem
*.key
