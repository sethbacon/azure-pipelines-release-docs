{
  "manifestVersion": 1,
  "id": "pipeline-tasks-release-docs",
  "name": "Pipeline Tasks for Release & Documentation",
  "version": "1.0.2",
  "publisher": "sethbacon",
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "scopes": [
    "vso.build"
  ],
  "description": "Conventional-commit changelog and release versioning, Markdown to HTML conversion, and ServiceNow knowledge base publishing for Azure Pipelines.",
  "public": false,
  "categories": [
    "Azure Pipelines"
  ],
  "tags": [
    "Release",
    "Changelog",
    "Documentation",
    "Markdown",
    "ServiceNow",
    "DevOps"
  ],
  "branding": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "icons": {
    "default": "images/icon.png",
    "large": "images/icon.png"
  },
  "content": {
    "details": {
      "path": "overview.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "files": [
    {
      "path": "Tasks/Changelog"
    },
    {
      "path": "Tasks/Markdown2Html"
    },
    {
      "path": "Tasks/PublishKbArticle"
    }
  ],
  "repository": {
    "type": "git",
    "uri": "https://github.com/sethbacon/azure-pipelines-release-docs"
  },
  "contributions": [
    {
      "id": "custom-changelog-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "Tasks/Changelog/ChangelogV1"
      }
    },
    {
      "id": "custom-markdown2html-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "Tasks/Markdown2Html/Markdown2HtmlV1"
      }
    },
    {
      "id": "custom-publish-kb-article-task",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "Tasks/PublishKbArticle/PublishKbArticleV1"
      }
    }
  ]
}