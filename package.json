{
  "name": "release-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Azure DevOps extension: release engineering and documentation publishing tasks.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sethbacon/azure-pipelines-release-docs.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rimraf ./build",
    "build:release": "npm run clean && npm run deps && npm run compile && npm run deps:prune && npm run copy",
    "copy": "node scripts/copy-build.js",
    "package:self": "tfx extension create --rev-version --manifest-globs azure-devops-extension.json task.json --overrides-file ./configs/self.json --root ./build",
    "package:dev": "tfx extension create --rev-version --manifest-globs azure-devops-extension.json task.json --overrides-file ./configs/dev.json --root ./build",
    "package:release": "tfx extension create --manifest-globs azure-devops-extension.json --overrides-file ./configs/release.json --root ./build",
    "deps": "node scripts/for-each-task.js ci",
    "deps:prune": "node scripts/for-each-task.js prune",
    "compile": "node scripts/for-each-task.js compile",
    "test:all": "node scripts/for-each-task.js test",
    "check:versions": "node scripts/check-versions.js",
    "check:docs-claims": "node scripts/check-docs-claims.js"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tfx-cli": "0.23.4",
    "typescript": "^5.9.3"
  }
}