{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "pipeline-tasks-release-docs",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "initial-version": "0.1.0",
      "draft": true,
      "force-tag-creation": true,
      "extra-files": [
        {
          "type": "json",
          "path": "azure-devops-extension.json",
          "jsonpath": "$.version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "deps",
          "section": "Dependencies"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "refactor",
          "section": "Refactor"
        },
        {
          "type": "revert",
          "section": "Reverts"
        },
        {
          "type": "security",
          "section": "Security"
        },
        {
          "type": "ci",
          "section": "CI",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Chores",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        }
      ]
    }
  }
}