{
  "loc.friendlyName": "Changelog and Release Version",
  "loc.helpMarkDown": "Parses conventional commits since the last release tag, computes the next version, prepends a release section to CHANGELOG.md, stamps version files, and opens or updates a release pull request. Authenticates as the pipeline's own identity via SystemVssConnection: the Build Service account needs **Contribute** and **Contribute to pull requests** on the target repository.",
  "loc.description": "Derive the next semantic version from conventional commits, update CHANGELOG.md and version files, and open or update a release pull request",
  "loc.instanceNameFormat": "Changelog and release version",
  "loc.input.label.workingDirectory": "Working directory",
  "loc.input.help.workingDirectory": "Repository root. Defaults to the agent's current directory.",
  "loc.input.label.changelogPath": "Changelog path",
  "loc.input.help.changelogPath": "Path to the changelog, relative to the working directory. Created with a Keep a Changelog header if absent.",
  "loc.input.label.tagPrefix": "Tag prefix",
  "loc.input.help.tagPrefix": "Prefix on release tags, e.g. `v` for `v1.2.3`.",
  "loc.input.label.targetBranch": "Target branch",
  "loc.input.help.targetBranch": "Branch the release pull request targets.",
  "loc.input.label.capZeroMajor": "Keep pre-1.0 releases pre-1.0",
  "loc.input.help.capZeroMajor": "When the current major is 0, a breaking change bumps the MINOR (0.3.7 to 0.4.0) instead of reaching 1.0.0. Matches release-please's `bump-minor-pre-major`. Turn off for strict semver.",
  "loc.input.label.versionFiles": "Version files",
  "loc.input.help.versionFiles": "One `path#$.json.path` per line, e.g. `azure-devops-extension.json#$.version`. A bare path defaults to `$.version`. Fails if a listed path does not resolve.",
  "loc.input.label.commitLimit": "Commit limit",
  "loc.input.help.commitLimit": "Maximum commits read from history. Bounds memory on a repository that has never been tagged.",
  "loc.input.label.openPullRequest": "Open or update the release pull request",
  "loc.input.help.openPullRequest": "When off, the task updates files and sets its output variables without calling the Azure DevOps REST API.",
  "loc.input.label.accessToken": "Access token",
  "loc.input.help.accessToken": "Overrides the job's own SystemVssConnection token. Only needed for cross-repository or cross-organisation publishing. Pass a secret variable, never a literal.",
  "loc.input.label.dryRun": "Dry run",
  "loc.input.help.dryRun": "Compute and print the release without writing any file or calling the REST API.",
  "loc.messages.CommitsConsidered": "Read %s commit(s), of which %s parsed as conventional commits, since %s.",
  "loc.messages.NothingToRelease": "No releasable change since the last tag: every commit was a silent type or unparseable.",
  "loc.messages.VersionResolved": "Version %s -> %s (%s bump).",
  "loc.messages.VersionFileMissing": "Version file %s does not exist; skipping it.",
  "loc.messages.VersionFileUnstampable": "Version file %s has no value at %s, so the release would ship a manifest still claiming the previous version.",
  "loc.messages.DryRunSummary": "Dry run: version %s, changelog %s, %s version file(s) would be stamped.",
  "loc.messages.DryRunComplete": "Dry run complete for %s. No file was written and no pull request was opened.",
  "loc.messages.FilesUpdated": "Updated the changelog and version files for %s.",
  "loc.messages.AccessTokenUnavailable": "No access token is available. Enable 'Allow scripts to access the OAuth token' on the job, or supply the accessToken input.",
  "loc.messages.PipelineContextMissing": "System.TeamFoundationCollectionUri, System.TeamProject and Build.Repository.ID must all be set; this task must run in an Azure Pipelines build.",
  "loc.messages.AdoRequestFailed": "Azure DevOps request failed (%s): HTTP %s %s",
  "loc.messages.AdoResponseUnparseable": "Azure DevOps returned a response for '%s' that is not JSON.",
  "loc.messages.ReleasePrTitle": "chore(main): release %s",
  "loc.messages.ReleasePrReady": "Release pull request for %s is ready: !%s"
}
